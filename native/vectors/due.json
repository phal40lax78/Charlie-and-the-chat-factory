      "name": "nothing to wait for",
      "input": {
        "fn": "due",
        "zone": "UTC",
        "utcOffsetMinutes": 0,
        "now": "2026-10-15T09:00:00.0000000Z",
        "job": {"id": "j1", "provider": "claude"}
      },
      "expect": {"due": null}
    },
