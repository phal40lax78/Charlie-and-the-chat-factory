{
  "about": "A run's stdout as Invoke-ChatqProcess (src/queue.ps1) reads it: a StreamReader over UTF-8 that detects a byte-order mark, ReadLineAsync line by line, each line written to the .jsonl log and then handed to -OnLine; and the 1048576-code-unit rule of Update-ChatqClaudeState. input: the bytes (hex), or a recipe {pre, line {head, fill, count, tail}, post} for a long line. expect: lines (past 256 code units as {units, sha256} of its UTF-8), log (the .jsonl as written on Windows, CRLF after each line; past 512 bytes as {length, sha256}), parsed (Update-ChatqClaudeState found the init line).",
  "cases": [
    {"name": "nothing", "input": {"hex": ""}, "expect": {"lines": [], "log": "", "parsed": []}},
    {
      "name": "a line with no end",
      "input": {"hex": "61"},
      "expect": {"lines": ["a"], "log": "610d0a", "parsed": [false]}
    },
    {
      "name": "a line, LF",
      "input": {"hex": "610a"},
      "expect": {"lines": ["a"], "log": "610d0a", "parsed": [false]}
    },
    {
      "name": "a line, CRLF",
      "input": {"hex": "610d0a"},
      "expect": {"lines": ["a"], "log": "610d0a", "parsed": [false]}
    },
    {
      "name": "a line, CR",
      "input": {"hex": "610d"},
      "expect": {"lines": ["a"], "log": "610d0a", "parsed": [false]}
    },
    {
      "name": "a lone CR between",
      "input": {"hex": "610d62"},
      "expect": {"lines": ["a", "b"], "log": "610d0a620d0a", "parsed": [false, false]}
    },
    {
      "name": "an empty line between",
      "input": {"hex": "610a0a62"},
      "expect": {"lines": ["a", "", "b"], "log": "610d0a0d0a620d0a", "parsed": [false, false, false]}
    },
    {
      "name": "LF alone",
      "input": {"hex": "0a"},
      "expect": {"lines": [""], "log": "0d0a", "parsed": [false]}
    },
    {
      "name": "LF LF LF",
      "input": {"hex": "0a0a0a"},
      "expect": {"lines": ["", "", ""], "log": "0d0a0d0a0d0a", "parsed": [false, false, false]}
    },
    {
      "name": "CRLF CRLF",
      "input": {"hex": "0d0a0d0a"},
      "expect": {"lines": ["", ""], "log": "0d0a0d0a", "parsed": [false, false]}
    },
    {
      "name": "CR CRLF",
      "input": {"hex": "0d0d0a"},
      "expect": {"lines": ["", ""], "log": "0d0a0d0a", "parsed": [false, false]}
    },
    {
      "name": "LF CR",
      "input": {"hex": "0a0d"},
      "expect": {"lines": ["", ""], "log": "0d0a0d0a", "parsed": [false, false]}
    },
    {
      "name": "CRLF then CR",
      "input": {"hex": "610d0a0d620a"},
      "expect": {"lines": ["a", "", "b"], "log": "610d0a0d0a620d0a", "parsed": [false, false, false]}
    },
    {
      "name": "stream-json lines",
      "input": {
        "hex": "7b2274797065223a2273797374656d222c2273756274797065223a22696e6974222c2273657373696f6e5f6964223a227331227d0a7b2274797065223a22617373697374616e74222c226d657373616765223a7b22636f6e74656e74223a5b5d7d7d0a"
      },
      "expect": {
        "lines": [
          "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"s1\"}",
          "{\"type\":\"assistant\",\"message\":{\"content\":[]}}"
        ],
        "log": "7b2274797065223a2273797374656d222c2273756274797065223a22696e6974222c2273657373696f6e5f6964223a227331227d0d0a7b2274797065223a22617373697374616e74222c226d657373616765223a7b22636f6e74656e74223a5b5d7d7d0d0a",
        "parsed": [true, false]
      }
    },
    {
