{
  "about": "The environment a run's CLI gets (src/queue.ps1). drop: $script:ChatqEnvDrop. runEnv: $script:ChatqRunEnv in its order. run: Invoke-ChatqRun for {cli, home, bridge (the permit's TimeoutMs, null for none), parent} -> {delta: its -SetEnv, null removing; block: the \"name=value\" entries New-ChatqProcessStartInfo's block holds, in .NET's order}. block: New-ChatqProcessStartInfo for {parent, setEnv} -> {block}. Only the case's names and those the run code sets or drops are kept from a block",
  "cases": [
    {
      "name": "drop list",
      "input": {"kind": "drop"},
      "expect": [
        "CLAUDECODE",
        "CLAUDE_PID",
        "CLAUDE_EFFORT",
        "CLAUDE_AGENT_SDK_VERSION",
        "CLAUDE_CODE_ENTRYPOINT",
        "CLAUDE_CODE_EXECPATH",
